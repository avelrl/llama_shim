# Repo-local convenience overrides. The shim auto-loads `.env` first and then
# lets real process environment variables win.

# Upstream OpenAI-compatible backend used by the shim.
LLAMA_BASE_URL=http://127.0.0.1:8081

# Server-side upstream provider routing tokens. Match these names from
# `llama.providers[].bearer_token_env` in config.yaml. These are used by the
# shim when it calls configured upstream providers; client harnesses should not
# need these unless they intentionally bypass the shim.
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=
# XIAOMI_API_KEY=
# SVGUN_API_KEY=
# MIMO_API_KEY=
# KIMI_API_KEY=

# Direct shimctl upstream probe. This calibrates one direct `llama.base_url`
# model at a time and does not use `llama.providers` routing.
# SHIMCTL_PROBE_BEARER_TOKEN=
# SHIMCTL_PROBE_MODEL=

# Codex CLI/eval client settings. Keep CODEX_PROVIDER as the Codex-local
# provider id for the shim; CODEX_MODEL is the public model sent to the shim
# and should usually be one provider/model alias at a time. GW_API_KEY is shim
# ingress auth for Codex, not a server-side upstream provider token.
# CODEX_PROVIDER=gateway-shim
# CODEX_API_KEY_ENV=GW_API_KEY
# CODEX_MODEL=provider/model
# CODEX_EVAL_MODELS=provider/model
# GW_API_KEY=shim-dev-key

# External Responses compatibility tester. OPENAI_BASE_URL should point at the
# shim. TESTER_MODEL should be one stable public provider/model alias. Use
# OPENAI_API_KEY as shim ingress auth for the tester, not as an upstream
# provider token.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# TESTER_MODEL=provider/model
# OPENAI_API_KEY=shim-test-key

# Optional richer local compaction runtime.
# RESPONSES_COMPACTION_BACKEND=model_assisted_text
# RESPONSES_COMPACTION_MODEL=local-compact-model
# RESPONSES_COMPACTION_BASE_URL=http://127.0.0.1:8081

# Common local paths and bind address.
SQLITE_PATH=./.data/shim.db
LOG_FILE_PATH=./.data/shim.log
SHIM_ADDR=:8080
